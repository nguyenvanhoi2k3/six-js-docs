{
  "rules": {
    "six-js-checklist": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren() || !newData.exists()",
      "$item": {
        ".validate": "newData.isBoolean() && $item.matches(/^[a-z-]+-[0-9]+$/)"
      }
    },
    "six-js-notes": {
      ".read": true,
      "$noteId": {
        ".write": true,
        ".validate": "newData.hasChildren(['title', 'content', 'author', 'createdAt', 'updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "icon": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "content": {
          ".validate": "newData.isString()"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "updatedBy": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= now) || newData.val() == data.val())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "pinned": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
